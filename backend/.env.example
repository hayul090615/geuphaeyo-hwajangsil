# PostgreSQL connection settings for local development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geuphaeyo
DB_USER=postgres
DB_PASSWORD=change_this_password

# Set to true only when the database requires SSL.
DB_SSL=false

# Kakao Developers 앱의 REST API 키입니다. JavaScript 키가 아닙니다.
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# 쉼표로 구분한 프론트엔드 허용 주소입니다.
FRONTEND_ORIGINS=http://localhost:5173,https://geuphaeyo-hwajangsil-integration-fr.vercel.app
