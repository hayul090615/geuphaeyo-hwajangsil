# PostgreSQL connection settings for local development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geuphaeyo
DB_USER=postgres
DB_PASSWORD=change_this_password

# Set to true only when the database requires SSL.
DB_SSL=false

# Google Cloud Console OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
FRONTEND_ORIGIN=http://localhost:5173

# SMTP email notifications for service requests
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_sender@gmail.com
SMTP_PASSWORD=your_google_app_password
SMTP_FROM=your_sender@gmail.com
